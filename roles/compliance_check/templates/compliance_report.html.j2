<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Compliance Report — {{ inventory_hostname }}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; background: #f5f5f5; }
    h1 { color: #333; }
    .meta { color: #666; margin-bottom: 30px; }
    .badge { display: inline-block; padding: 6px 14px; border-radius: 4px; font-weight: bold; font-size: 1.1em; }
    .PASS { background: #d4edda; color: #155724; }
    .FAIL { background: #f8d7da; color: #721c24; }
    table { border-collapse: collapse; width: 100%; margin-bottom: 30px; background: #fff; }
    th { background: #343a40; color: #fff; padding: 10px 14px; text-align: left; }
    td { padding: 9px 14px; border-bottom: 1px solid #dee2e6; }
    tr:hover { background: #f1f1f1; }
    .status-PASS { color: #155724; font-weight: bold; }
    .status-FAIL { color: #721c24; font-weight: bold; }
  </style>
</head>
<body>
  <h1>Server Compliance Report</h1>
  <div class="meta">
    <strong>Host:</strong> {{ inventory_hostname }}<br>
    <strong>Generated:</strong> {{ report_timestamp }}<br>
    <strong>Overall status:</strong>
    <span class="badge {{ overall_status }}">{{ overall_status }}</span>
  </div>

  <h2>Firmware</h2>
  <table>
    <tr><th>Component</th><th>Required</th><th>Actual</th><th>Status</th></tr>
    {% for f in firmware_findings %}
    <tr>
      <td>{{ f.name }}</td>
      <td>{{ f.required }}</td>
      <td>{{ f.actual }}</td>
      <td class="status-{{ f.status }}">{{ f.status }}</td>
    </tr>
    {% endfor %}
  </table>

  <h2>BIOS Attributes</h2>
  <table>
    <tr><th>Attribute</th><th>Required</th><th>Actual</th><th>Status</th></tr>
    {% for b in bios_findings %}
    <tr>
      <td>{{ b.attribute }}</td>
      <td>{{ b.required }}</td>
      <td>{{ b.actual }}</td>
      <td class="status-{{ b.status }}">{{ b.status }}</td>
    </tr>
    {% endfor %}
  </table>
</body>
</html>
